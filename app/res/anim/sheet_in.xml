<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_cubic">
    <translate android:fromYDelta="9%" android:toYDelta="0" android:duration="280" />
    <scale android:fromXScale="0.985" android:toXScale="1.0"
        android:fromYScale="0.985" android:toYScale="1.0"
        android:pivotX="50%" android:pivotY="100%" android:duration="280" />
    <alpha android:fromAlpha="0.55" android:toAlpha="1.0" android:duration="200" />
</set>
